; SV in Godot: a proof. Is Godot a better home for the Stage Visualizer's look than three.js in the browser?

config_version=5

[application]

config/name="Stage Visualizer"
config/version="0.54.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://fonts/AtkinsonHyperlegible-Regular.otf"

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
anti_aliasing/quality/use_debanding=true
limits/cluster_builder/max_clustered_elements=1024
